# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres

# OpenAI — powers ALL AI features (dialog, quiz, grading, STT, embeddings).
# Lighter, cost-efficient models are the defaults.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini                    # dialog (interview chat loop) + quiz/MCQ
OPENAI_GRADING_MODEL=gpt-4o                 # premium final grading (o3-mini = reasoning alt)
OPENAI_STT_MODEL=whisper-1                  # speech-to-text
OPENAI_EMBED_MODEL=text-embedding-3-small   # RAG vector-search embeddings
EMBED_DIM=384                               # embedding dimension (matches DB/Pinecone)

# Pinecone (vector store for RAG)
# pinecone-api=pcsk_...
# PINECONE_INDEX=course-content

# Gemini (Google AI) — Realtime Live API for the speech-to-speech oral interview.
# The browser connects directly to Gemini Live using a short-lived ephemeral
# token minted by the backend (see services/realtime.py). Get a key at
# https://aistudio.google.com/apikey — confirm the model below is available for
# bidiGenerateContent on your key/project before deploying. Note:
# gemini-2.5-flash-native-audio-latest reproducibly crashes the session when a
# custom voice + tool calling are both active — verified live, avoid it here.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
# Cheap text model that grades the Realtime interview's transcript afterward.
GEMINI_GRADING_MODEL=gemini-2.5-flash-lite
